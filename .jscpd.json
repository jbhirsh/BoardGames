{
  "path": ["src", "api", "e2e", "eval", "scripts", ".github/scripts"],
  "format": ["typescript", "tsx", "javascript", "css"],
  "ignore": [
    "**/node_modules/**",
    "**/__tests__/**",
    "**/*.test.*",
    "**/*.spec.ts",
    "src/data/gameWeights.ts",
    "src/data/wishlistArt.ts"
  ],
  "minTokens": 70,
  "minLines": 6,
  "reporters": ["console", "markdown"],
  "output": "jscpd-report",
  "gitignore": true,
  "exitCode": 1
}
