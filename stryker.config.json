{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "coverageAnalysis": "perTest",
  "reporters": ["html", "clear-text", "progress"],
  "mutate": [
    "src/utils/**/*.ts",
    "src/context/filterReducer.ts",
    "src/components/**/*.tsx",
    "src/App.tsx",
    "api/**/*.ts",
    "!**/*.d.ts"
  ],
  "mutator": {
    "excludedMutations": ["StringLiteral"]
  },
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 68
  }
}
