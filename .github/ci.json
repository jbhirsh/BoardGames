{
  "mutation": {
    "wiring": [
      "vite.config.ts",
      "src/setupTests.ts",
      "tsconfig*.json",
      "package.json",
      "package-lock.json",
      "patches/**",
      ".github/workflows/mutation.yml"
    ],
    "smoke": ["src/utils/filterUrl.ts", "src/utils/pickRandom.ts", "src/utils/urls.ts"]
  },
  "visuals": {
    "ui": ["src/**/*.{tsx,css}", "src/**/*Classes.ts", "index.html"],
    "notUi": ["**/*.test.tsx", "src/__tests__/**", "src/context/**", "src/main.tsx"]
  },
  "audit": {
    "graph": ["src", "api", "e2e"]
  },
  "readme-screenshots": {
    "shows": [
      "src/**",
      "public/**",
      "index.html",
      "e2e/readme.shots.ts",
      "e2e/visual.ts",
      "e2e/fixtures.ts",
      "playwright.config.ts",
      "package-lock.json",
      ".github/workflows/readme-screenshots.yml"
    ],
    "ignore": ["src/__tests__/**"],
    "source": "the production build, every /api call and the dictionary stubbed (e2e/readme.shots.ts)"
  }
}
