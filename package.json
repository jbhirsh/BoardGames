{
  "name": "board-games-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "//typeCoverage": [
    "src/gql/**: generated by graphql-codegen from the schema and operations (npm run codegen); its types are as good as the SDL"
  ],
  "scripts": {
    "dev": "vite",
    "prepare": "git config core.hooksPath .githooks || true",
    "build": "npm run typecheck && vite build",
    "typecheck": "node node_modules/@typescript/native/bin/tsc -b",
    "typecov": "for p in app api node eval sw e2e; do type-coverage -p tsconfig.$p.json --at-least 100 --ignore-files 'src/gql/**' || exit 1; done",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcruise": "depcruise src api e2e",
    "codegen": "graphql-codegen --config codegen.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db-migrate.ts",
    "db:copy": "node --env-file-if-exists=.env.local scripts/copy-from-redis.ts",
    "bgg-refresh": "node --env-file-if-exists=.env.local scripts/bgg-refresh.ts",
    "preview": "vite preview",
    "eval": "node eval/run-eval.ts",
    "box-art": "node scripts/fetch-box-art.ts",
    "pr-gif": "node scripts/gif.mjs",
    "rules-text": "node scripts/extract-rules-text.mjs",
    "rules-text-layer": "node scripts/add-text-layer.mjs",
    "test:mutation": "stryker run",
    "jscpd": "jscpd",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.18",
    "@google/genai": "^2.32.0",
    "@graphql-yoga/plugin-csrf-prevention": "^4.0.1",
    "@libsql/client": "^0.18.0",
    "@sentry/node": "^11.11.0",
    "@sentry/react": "^11.11.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.41.0",
    "@vercel/analytics": "^2.0.1",
    "better-auth": "^1.7.18",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "graphql": "^17.1.0",
    "graphql-yoga": "^6.0.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/client-preset": "^6.2.3",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@playwright/test": "^1.65.0",
    "@sentry/vite-plugin": "^11.11.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "axe-core": "^4.14.0",
    "dependency-cruiser": "^18.7.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "eslint-plugin-drizzle": "^0.2.3",
    "eslint-plugin-jsdoc": "^65.4.4",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-playwright": "^2.12.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "jscpd": "^5.4.2",
    "jsdom": "^31.0.0",
    "knip": "^6.44.1",
    "pdf-lib": "^1.17.1",
    "pdf-to-img": "^7.0.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "^7.0.0",
    "type-coverage": "^2.31.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "unpdf": "^2.1.0",
    "vite": "^8.3.6",
    "vitest": "^5.0.3",
    "vitest-axe": "^0.1.0"
  }
}
