{
  "name": "board-games-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prepare": "git config core.hooksPath .githooks || true",
    "postinstall": "patch-package",
    "build": "npm run typecheck && vite build",
    "typecheck": "node node_modules/@typescript/native/bin/tsc -b",
    "lint": "eslint .",
    "depcruise": "depcruise src api e2e",
    "preview": "vite preview",
    "eval": "node eval/run-eval.ts",
    "game-weights": "node scripts/fetch-game-weights.ts",
    "wishlist-art": "node scripts/fetch-wishlist-art.ts",
    "collection-art": "node scripts/fetch-collection-art.ts",
    "rules-text-layer": "node scripts/add-text-layer.mjs",
    "test:mutation": "stryker run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "@sentry/node": "^11.6.0",
    "@sentry/react": "^11.6.0",
    "@sentry/vite-plugin": "^5.4.1",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/analytics": "^2.0.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vercel/node": "^23.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "axe-core": "^4.14.0",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.12.0",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "patch-package": "^8.0.1",
    "pdf-lib": "^1.17.1",
    "pdf-to-img": "^7.0.0",
    "tesseract.js": "^7.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1",
    "unpdf": "^1.8.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vitest-axe": "^0.1.0"
  }
}
