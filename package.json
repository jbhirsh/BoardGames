{
  "name": "board-games-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prepare": "git config core.hooksPath .githooks || true",
    "postinstall": "patch-package",
    "build": "npm run typecheck && vite build",
    "typecheck": "node node_modules/@typescript/native/bin/tsc -b",
    "typecov": "for p in app api node eval sw e2e; do type-coverage -p tsconfig.$p.json --at-least 100 --ignore-files 'src/gql/**' || exit 1; done",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcruise": "depcruise src api e2e",
    "codegen": "graphql-codegen --config codegen.ts",
    "preview": "vite preview",
    "eval": "node eval/run-eval.ts",
    "game-weights": "node scripts/fetch-game-weights.ts",
    "wishlist-art": "node scripts/fetch-wishlist-art.ts",
    "collection-art": "node scripts/fetch-collection-art.ts",
    "pr-gif": "node scripts/record-pr-gif.ts",
    "rules-text": "node scripts/extract-rules-text.mjs",
    "rules-text-layer": "node scripts/add-text-layer.mjs",
    "test:mutation": "stryker run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@graphql-yoga/plugin-csrf-prevention": "^4.0.1",
    "@sentry/node": "^11.8.0",
    "@sentry/react": "^11.8.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/analytics": "^2.0.1",
    "graphql": "^17.0.2",
    "graphql-yoga": "^6.0.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/client-preset": "^6.2.3",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@playwright/test": "^1.64.1",
    "@sentry/vite-plugin": "^11.8.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.14.0",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jscpd": "^5.4.2",
    "jsdom": "^30.1.3",
    "knip": "^6.42.1",
    "patch-package": "^8.0.1",
    "pdf-lib": "^1.17.1",
    "pdf-to-img": "^7.0.1",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "^7.0.0",
    "type-coverage": "^2.30.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.2",
    "unpdf": "^1.9.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vitest-axe": "^0.1.0"
  }
}
