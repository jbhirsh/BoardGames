# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — never commit real secrets.

# --- Sentry error monitoring ---
# Client (browser) DSN, read by src/instrument.ts. Exposed to the browser,
# so it must be prefixed with VITE_ to be inlined by Vite.
VITE_SENTRY_DSN=https://<public-key>@<org-id>.ingest.<region>.sentry.io/<project-id>
# Server DSN for the Vercel serverless functions, read by api/chat.ts.
SENTRY_DSN=https://<public-key>@<org-id>.ingest.<region>.sentry.io/<project-id>

# --- Google Gemini (rules chat) ---
# Server-side API key used by api/chat.ts. Never expose this to the browser.
GEMINI_API_KEY=your-gemini-api-key

# --- Turso (the database, #290) ---
# Each deployment has its own database: production's and preview's URL and
# token go in Vercel for that environment, never here: a deploy sets up a
# new, empty one itself.
# TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
# TURSO_AUTH_TOKEN=your-turso-token
# A local SQLite file for development (`npm run db:migrate` builds it; the
# db scripts read this file).
DEV_DB_PATH=local.db

# --- Sign-in (Better Auth: Google and passkeys, api/_auth.ts) ---
# Set in Vercel, never here: sign-in isn't tried locally (`npm run dev`
# serves no API, and a local sign-in would go through production with the
# proxy's secret on the laptop). A deploy missing one fails its build
# (scripts/check-auth-env.ts).
#   BETTER_AUTH_SECRET    production and preview, each its own
#                         (`openssl rand -base64 32`)
#   GOOGLE_CLIENT_ID      production and preview: the Google OAuth client
#   GOOGLE_CLIENT_SECRET  production only: only production exchanges a code,
#                         and a preview build that has it fails
#   OAUTH_PROXY_SECRET    production and preview, the same value: previews
#                         sign in through production

# --- Upstash Redis / Vercel KV (wishlist voting) ---
# Used by api/votes.ts. Provided automatically when the Vercel KV /
# Upstash integration is linked; set manually for local development.
KV_REST_API_URL=https://your-instance.upstash.io
KV_REST_API_TOKEN=your-upstash-rest-token

# --- Resend (friend suggestions) ---
# Used by api/suggestions.ts to email the owner an approve/deny link for each
# suggested game. Suggestions are refused (503) until both are set.
RESEND_API_KEY=re_your-resend-api-key
# Also the Google account that signs in as the owner (api/_auth.ts); a
# production build without it fails, as no one could be the owner.
SUGGESTIONS_TO=you@example.com
# Optional sender; Resend's free tier can send from onboarding@resend.dev to
# the account owner's own address without verifying a domain.
SUGGESTIONS_FROM="The Game Room <onboarding@resend.dev>"
# Optional absolute origin for the links in that email; defaults to the
# Vercel production URL when deployed.
APP_URL=http://localhost:5173

# --- BoardGameGeek (details and box art for approved suggestions) ---
# BGG's XML API answers 401 without a registered token. Without it (or if BGG
# refuses it) approvals still go through, just with no players/time/
# description/art, and Sentry gets an error naming BGG_API_TOKEN. The
# built-in list's art comes from `npm run wishlist-art`, which needs no token.
BGG_API_TOKEN=your-bgg-api-token
