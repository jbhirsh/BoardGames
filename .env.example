# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — never commit real secrets.

# --- Sentry error monitoring ---
# Client (browser) DSN, read by src/instrument.ts. Exposed to the browser,
# so it must be prefixed with VITE_ to be inlined by Vite.
VITE_SENTRY_DSN=https://<public-key>@<org-id>.ingest.<region>.sentry.io/<project-id>
# Server DSN for the Vercel serverless functions, read by api/chat.ts.
SENTRY_DSN=https://<public-key>@<org-id>.ingest.<region>.sentry.io/<project-id>

# --- Google Gemini (rules chat) ---
# Server-side API key used by api/chat.ts. Never expose this to the browser.
GEMINI_API_KEY=your-gemini-api-key

# --- Upstash Redis / Vercel KV (wishlist voting) ---
# Used by api/votes.ts. Provided automatically when the Vercel KV /
# Upstash integration is linked; set manually for local development.
KV_REST_API_URL=https://your-instance.upstash.io
KV_REST_API_TOKEN=your-upstash-rest-token
