{
  // Here beside the code, not as tsconfig.api.json at the root: Vercel's
  // function build type-checks api/ again with the tsconfig.json nearest
  // the entrypoint, and given the root's (no compilerOptions) it checked
  // without strict or these libraries, logging dozens of false errors.
  // It turns strict off for a config that doesn't set `module` itself, so
  // that stays here rather than moving to the base. It also reads `target`
  // before `extends`, so it emits ES2021, not the base's ES2023.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.api.tsbuildinfo",
    "lib": ["ES2023"],
    // NodeNext, as Vercel runs api/ as Node ESM: a relative import Node's
    // loader rejects (an extensionless one, the #26 incident that took
    // production down while every check passed) fails tsc -b here instead.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"]
  },
  "include": ["."]
}
