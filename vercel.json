{
  "outputDirectory": "dist",
  "framework": "vite",
  "devCommand": "npx vite --port $PORT",
  "functions": {
    "api/graphql.ts": {
      "includeFiles": "rules-text/**",
      "maxDuration": 60
    },
    "api/chat.ts": {
      "includeFiles": "rules-text/**",
      "maxDuration": 60
    },
    "api/suggestions.ts": {
      "maxDuration": 15
    },
    "api/auth.ts": {
      "maxDuration": 15
    },
    "api/votes.ts": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "rewrites": [{ "source": "/((?!api/)(?!.*\\..*).*)", "destination": "/index.html" }]
}
