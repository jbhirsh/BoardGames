{
  "outputDirectory": "dist",
  "framework": "vite",
  "devCommand": "npx vite --port $PORT",
  "functions": {
    "api/chat.ts": {
      "includeFiles": "rules-text/**"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/)(?!.*\\..*).*)", "destination": "/index.html" }
  ]
}
