{
  "outputDirectory": "dist",
  "framework": "vite",
  "devCommand": "npx vite --port $PORT",
  "functions": {
    "api/graphql.ts": {
      "includeFiles": "rules-text/**",
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(approve|deny|sign-in/confirm)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/)(?!.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
