{
  "outputDirectory": "dist",
  "framework": "vite",
  "buildCommand": "npm run build && node scripts/check-auth-env.ts && npm run db:migrate && npm run db:copy && npm run bgg-refresh",
  "devCommand": "npx vite --port $PORT",
  "functions": {
    "api/graphql.ts": {
      "includeFiles": "rules-text/**",
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(approve|deny)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "/api/graphql"
    },
    {
      "source": "/((?!api/)(?!.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
